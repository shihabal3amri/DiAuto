<?xml version="1.0" encoding="utf-8"?>
<!-- Stylized car dashboard with a centered head-unit screen. The screen rectangle is
     centered in the viewport so a TextView with layout_gravity="center" overlaid on top of
     an ImageView (fitCenter) lines up with the screen. Generic, no brand logos. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">

    <!-- Dashboard body -->
    <path
        android:fillColor="#38414A"
        android:pathData="M0,124 C60,96 118,88 160,88 C202,88 260,96 320,124 L320,180 L0,180 Z" />
    <!-- Dashboard top edge highlight -->
    <path
        android:strokeColor="#4E575F"
        android:strokeWidth="2"
        android:fillColor="#00000000"
        android:pathData="M0,124 C60,96 118,88 160,88 C202,88 260,96 320,124" />

    <!-- Steering wheel (left) -->
    <path
        android:strokeColor="#525C65"
        android:strokeWidth="6"
        android:fillColor="#00000000"
        android:pathData="M16,152 a24,24 0 1,0 48,0 a24,24 0 1,0 -48,0" />
    <path
        android:strokeColor="#525C65"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M18,152 L62,152 M40,152 L40,132" />
    <path
        android:fillColor="#525C65"
        android:pathData="M40,152 m-7,0 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0" />

    <!-- Head-unit bezel (centered) -->
    <path
        android:fillColor="#454E57"
        android:pathData="M108,50 L212,50 A12,12 0 0 1 224,62 L224,120 A12,12 0 0 1 212,132 L108,132 A12,12 0 0 1 96,120 L96,62 A12,12 0 0 1 108,50 Z" />
    <!-- Screen (dark, centered around 160,91) -->
    <path
        android:fillColor="#0F1A24"
        android:pathData="M112,58 L208,58 A6,6 0 0 1 214,64 L214,118 A6,6 0 0 1 208,124 L112,124 A6,6 0 0 1 106,118 L106,64 A6,6 0 0 1 112,58 Z" />
    <!-- Screen accent status strip -->
    <path
        android:fillColor="#26A69A"
        android:pathData="M116,64 L152,64 A2,2 0 0 1 154,66 L154,68 A2,2 0 0 1 152,70 L116,70 A2,2 0 0 1 114,68 L114,66 A2,2 0 0 1 116,64 Z" />
</vector>
